#!/bin/sh
# X session configuration.
#
# Run by startx once the X server is up. The session lasts as long as the last
# command, so everything else comes before the `exec i3` that ends this file.
# Full reference: https://wiki.archlinux.org/title/Xinit
#
# Kept in sync with ~/.config/i3/config
#   - TERMINAL names the same terminal as i3's $terminal.

# =============================================================================
# Environment
# =============================================================================

# Default terminal for apps that read $TERMINAL, such as i3-sensible-terminal;
# see "Kept in sync" above.
export TERMINAL="ghostty"

# Runs the distribution's session hooks, as the stock xinitrc does. Among
# them, systemd's 50-systemd-user.sh passes DISPLAY and XAUTHORITY to services
# started through D-Bus, dunst among them, which otherwise start without a
# display and fail silently. Must run here, not from i3: i3 starts its exec
# lines without waiting for them, so a service could start before the import.
if [ -d /etc/X11/xinit/xinitrc.d ]; then
  for f in /etc/X11/xinit/xinitrc.d/?*.sh; do
    [ -x "$f" ] && . "$f"
  done
  unset f
fi

# =============================================================================
# Window manager
# =============================================================================

# Replaces this shell, so the X session ends when i3 exits.
exec i3
