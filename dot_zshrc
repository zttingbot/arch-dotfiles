# Zsh interactive shell configuration.
#
# Ordered by dependency: environment and shell options are established before
# any tool is initialized, since several tools read them at init time. Nothing
# here is machine-specific — that belongs in ~/.zshrc.local, sourced last.

# =============================================================================
# Environment
# =============================================================================

# Keep terminal and GUI editor behavior consistent. SUDO_EDITOR is separate
# because `sudoedit` reads only that variable, with no fallback to EDITOR.
export EDITOR="nvim"
export VISUAL="$EDITOR"
export SUDO_EDITOR="$EDITOR"

# =============================================================================
# Paths
# =============================================================================

# Keep PATH free of duplicates, so re-sourcing this file (or nesting shells)
# does not stack up repeated entries. zsh keeps `path` and `PATH` in sync.
typeset -U path PATH

# User-installed binaries (pip, cargo, npm) take precedence over system ones.
export PATH="$HOME/.local/bin:$PATH"

# =============================================================================
# History
# =============================================================================

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

# Persist across sessions and share live between open terminals, so a command
# run in one pane is immediately recallable in another. Timestamps make it
# possible to reconstruct when something was run.
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY

# Keep the file useful rather than exhaustive: drop consecutive repeats, omit
# commands typed with a leading space, evict duplicates before unique entries
# when trimming to SAVEHIST, and normalize stray whitespace.
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_REDUCE_BLANKS

# Load a `!` expansion into the buffer for review instead of running it blind.
setopt HIST_VERIFY

# =============================================================================
# Completion
# =============================================================================

# Must precede the tool initialization below: zoxide and fzf register their
# completions with `compdef`, which is what compinit defines.
autoload -Uz compinit
compinit

# =============================================================================
# Tool initialization
# =============================================================================

# Starship reads STARSHIP_CONFIG when it initializes, so it has to be set
# first. The Linux console has no Nerd Font or truecolor support, so it gets a
# stripped-down config rather than a broken-looking prompt.
if [[ "$TERM" == "linux" ]]; then
  export STARSHIP_CONFIG="$HOME/.config/starship/starship-tty.toml"
else
  export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Suggests completions from history; Right Arrow accepts one in full.
if [[ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# Frecency-ranked directory jumping: `z <name>`, or `zi` to pick interactively.
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# Ctrl+R history, Ctrl+T files, Alt+C cd, and `**<Tab>` fuzzy completion.
# `fzf --zsh` emits both the key bindings and the completion module, which
# avoids hardcoding distro-specific paths under /usr/share/fzf.
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# Must come last: it wraps every widget defined up to this point.
if [[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# =============================================================================
# Local overrides
# =============================================================================

# Machine-specific settings live here, deliberately untracked by chezmoi.
if [[ -f "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
